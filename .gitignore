# Dependencies
/node_modules/
/.pnp
.pnp.*
# Keep authored Yarn tooling if the project adopts Yarn.
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Generated builds and framework state
/dist/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys
.env*
.dev.vars*
*.pem

# Checkout-local tool state
/.wrangler/
/.sites-runtime/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/

# OS metadata
.DS_Store

# Direct Cloudflare static build
/dist-cloudflare/

# Local browser state and processing logs
/.playwright-cli/
/output/
/output-*.log
/output-*.txt

# Local publication metadata, temporary processing and QA captures
/.openai/
/.chart-data-*/
/.firetrace-editorial-build/
/qa/
/worker/*backup*
/worker/*before-*.txt
__pycache__/
*.pyc
*.key
*.p12
*.pfx
# Keep raw NASA archives and local datasets out of source control
*.zip
*.tar
*.tar.gz
*.download
/raw/
/private/
/datasets/

# Editor backups anywhere in the source tree
*.backup
*.bak

# Official FIRMS compressed source cache and incremental processing
/.firms-cache/
