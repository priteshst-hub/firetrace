{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "firetrace-black-summer",
  "account_id": "3c9d22490a1691816524248892c10ccf",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "assets": {
    "directory": "./dist-cloudflare",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "worker/firetrace-api.ts",
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "CHAT_LIMIT",
      "namespace_id": "8432101",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "CHAT_GLOBAL",
      "namespace_id": "8432102",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ]
}
